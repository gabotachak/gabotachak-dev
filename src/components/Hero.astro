---
import { translations, type Lang } from "../i18n/translations";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = translations[lang];
---

<!-- PLACEHOLDER: renders existing data with the new primitives. The hero agent replaces copy and layout. -->
<section class="section hero">
  <div class="container hero-grid">
    <img class="avatar" src="/avatar.jpg" alt="Gabriel Anzola Tachak" width="96" height="96" fetchpriority="high" />
    <div>
      <p class="eyebrow">{t.roles[0]}</p>
      <h1>Gabriel Anzola Tachak</h1>
      <p class="lede">{t.hero.bio}</p>
      <p class="meta availability"><span class="status-dot" aria-hidden="true"></span>{t.hero.availability}</p>
      <p class="actions">
        <a class="btn btn-primary" href="mailto:hi@gabotachak.dev">hi@gabotachak.dev</a>
        <a class="btn btn-secondary ext" href="/cv.pdf" target="_blank" rel="noopener noreferrer">{t.nav.cv}</a>
      </p>
    </div>
  </div>
</section>

<style>
  .hero { padding-top: clamp(2.5rem, 6vw, 4.5rem); }
  .hero-grid { display: grid; gap: 1.5rem; align-items: start; }
  @media (min-width: 640px) { .hero-grid { grid-template-columns: auto 1fr; gap: 2rem; } }
  .avatar { width: 6rem; height: 6rem; border-radius: 50%; border: 1px solid var(--border); }
  h1 { margin-block: 0.5rem 1rem; }
  .availability { display: flex; align-items: center; gap: 0.5rem; margin-top: 1rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; max-width: none; }
</style>
