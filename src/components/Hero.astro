---
import { translations, type Lang } from "../i18n/translations";

interface Props { lang: Lang }
const { lang } = Astro.props;
const h = translations[lang].hero;
---

<section class="section hero">
  <div class="container hero-grid">
    <img class="avatar" src="/avatar.jpg" alt="" width="96" height="96" fetchpriority="high" />
    <div>
      <p class="eyebrow">{h.eyebrow}</p>
      <h1>Gabriel Anzola Tachak</h1>
      <p class="lede">{h.lede}</p>
      <p class="meta availability"><span class="status-dot" aria-hidden="true"></span>{h.availability}</p>
      <p class="meta location">{h.location}</p>
      <div class="actions">
        <a class="btn btn-primary" href="mailto:hi@gabotachak.dev">{h.email}</a>
        <a class="btn btn-secondary ext" href="/cv.pdf" target="_blank" rel="noopener noreferrer">{h.cv}</a>
        <a class="link" href="https://github.com/gabotachak" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a class="link" href="https://linkedin.com/in/gabotachak" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { padding-top: clamp(2.5rem, 6vw, 4.5rem); padding-bottom: clamp(3rem, 6vw, 4.5rem); }
  .hero-grid { display: grid; gap: 1.5rem; align-items: start; }
  @media (min-width: 640px) { .hero-grid { grid-template-columns: auto 1fr; gap: 2.5rem; } }
  .avatar { width: 6rem; height: 6rem; border-radius: 50%; border: 1px solid var(--border); object-fit: cover; }
  h1 { margin-block: 0.5rem 1rem; }
  .availability { display: flex; align-items: center; gap: 0.5rem; margin-top: 1.25rem; max-width: none; }
  .location { margin-top: 0.25rem; padding-inline-start: 1rem; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.5rem; margin-top: 1.75rem; }
  .actions .btn-secondary { margin-inline-end: -0.25rem; }
  .actions .link { display: inline-flex; align-items: center; min-height: 2.75rem; }
</style>
