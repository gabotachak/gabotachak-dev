---
import { translations, type Lang } from "../i18n/translations";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = translations[lang];

// Grouped by category, in CV order. Ratings stay in the CV only.
type Cat = keyof typeof t.stackTable.categories;
const groups: { cat: Cat; skills: string[] }[] = [
  { cat: "languages", skills: ["Go", "Python", "SQL"] },
  { cat: "frameworks", skills: ["Gin / Gorilla Mux", "FastAPI / Django / Flask"] },
  { cat: "protocols", skills: ["gRPC & REST APIs", "Distributed Systems"] },
  { cat: "databases", skills: ["PostgreSQL / MySQL", "Redis / MongoDB"] },
  {
    cat: "cloud",
    skills: ["GCP (Pub/Sub, Workflows, Storage)", "Docker & Linux", "Kubernetes", "GitHub Actions & CI/CD", "Terraform", "Grafana", "Spinnaker"],
  },
  { cat: "security", skills: ["OAuth2, JWT & RBAC", "Vault"] },
  { cat: "ai", skills: ["Ollama", "LlamaIndex"] },
  { cat: "tools", skills: ["Selenium", "Twilio"] },
];
const alsoUsed = ["TypeScript", "Bash", "AWS", "Claude", "Gemini"];
---

<section class="section band-surface" id="stack" aria-labelledby="stack-title">
  <div class="container">
    <h2 class="section-title" id="stack-title">
      {t.sections.stack}
    </h2>
    <p class="note">{t.sections.stackNote}</p>
    <dl class="groups">
      {groups.map((g) => (
        <div>
          <dt class="eyebrow">{t.stackTable.categories[g.cat]}</dt>
          <dd>
            <ul class="tech-line">
              {g.skills.map((s) => (
                <li>{s}</li>
              ))}
            </ul>
          </dd>
        </div>
      ))}
    </dl>
    <p class="meta also">
      {t.sections.alsoLabel}: {alsoUsed.join(" · ")}
    </p>
  </div>
</section>

<style>
  .note {
    max-width: var(--measure);
    color: var(--text-2);
    margin: 0 0 1.5rem;
  }
  .groups {
    margin: 0;
    display: grid;
    gap: 0 3rem;
  }
  @media (min-width: 768px) {
    .groups {
      grid-template-columns: 1fr 1fr;
    }
  }
  .groups > div {
    padding-block: 1rem;
    border-top: 1px solid var(--border);
  }
  dt {
    margin-bottom: 0.375rem;
  }
  dd {
    margin: 0;
  }
  .also {
    max-width: none;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
</style>
