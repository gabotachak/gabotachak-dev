---
import { translations, type Lang } from "../i18n/translations";
import { nb } from "../i18n/format";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = translations[lang];

// Role titles, bullets and work mode live in translations; this holds the language-neutral facts.
// PLACEHOLDER: the experience agent moves `period` to structured dates formatted with Intl.DateTimeFormat.
const jobMeta = [
  { company: "Workstate", client: "Compass", period: "Apr 2026 - Jul 2026",
    tech: ["Go", "gRPC", "GCP", "Kubernetes", "Grafana"] },
  { company: "NEORIS", client: "The Home Depot US", period: "Dec 2025 - Mar 2026",
    tech: ["Go", "gRPC", "GCP", "Pub/Sub", "Redis", "Vault", "Terraform", "GitHub Actions", "Spinnaker", "Grafana"] },
  { company: "Personally AI", client: null, period: "Oct 2025 - Nov 2025",
    tech: ["Python", "Ollama", "RAG", "Selenium", "Twilio", "WhatsApp API"] },
  { company: "Mercado Libre", client: null, period: "Jun 2021 - Sep 2025",
    tech: ["Go", "Python", "REST APIs", "IAM", "RBAC", "OAuth2", "AWS", "GCP"] },
];
const jobs = jobMeta.map((m, i) => ({ ...m, ...t.experience.jobs[i] }));
---

<section class="section" id="experience" aria-labelledby="experience-title">
  <div class="container">
    <h2 class="section-title" id="experience-title">{t.sections.experience}</h2>
    <ol class="jobs">
      {jobs.map((job) => (
        <li>
          <h3>{job.role} · {job.company}{job.client && ` · ${job.client}`}</h3>
          <p class="meta">{job.period} · {job.mode}</p>
          <ul class="bullets">{job.bullets.map((b) => <li>{nb(b)}</li>)}</ul>
          <ul class="tech-line">{job.tech.map((tag) => <li>{tag}</li>)}</ul>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .jobs { list-style: none; margin: 0; padding: 0; }
  .jobs > li { display: grid; gap: 0.75rem; padding-block: 1.5rem; border-top: 1px solid var(--border); }
  h3 { font-size: var(--fs-lede); }
  .bullets { margin: 0; padding-left: 1.25rem; max-width: var(--measure); }
  .bullets li { list-style: disc; margin-block: 0.375rem; }
</style>
