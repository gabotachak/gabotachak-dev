---
import { translations, type Lang } from "../i18n/translations";
import { nb } from "../i18n/format";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = translations[lang];

// Role titles, bullets and work mode live in translations; this holds the language-neutral facts.
// Dates are [year, month]. UTC on both ends so the build timezone cannot shift a month.
type YM = [number, number];
const jobMeta: { company: string; client: string | null; start: YM; end: YM; tech: string[] }[] = [
  { company: "Workstate", client: "Compass", start: [2026, 4], end: [2026, 7],
    tech: ["Go", "gRPC", "GCP", "Kubernetes", "Grafana"] },
  { company: "NEORIS", client: "The Home Depot US", start: [2025, 12], end: [2026, 3],
    tech: ["Go", "gRPC", "GCP", "Pub/Sub", "Redis", "Vault", "Terraform", "GitHub Actions", "Spinnaker", "Grafana"] },
  { company: "Personally AI", client: null, start: [2025, 10], end: [2025, 11],
    tech: ["Python", "Ollama", "RAG", "Selenium", "Twilio", "WhatsApp API"] },
  { company: "Mercado Libre", client: null, start: [2021, 6], end: [2025, 9],
    tech: ["Go", "Python", "REST APIs", "IAM", "RBAC", "OAuth2", "AWS", "GCP"] },
];
const month = new Intl.DateTimeFormat(lang, { month: "short", year: "numeric", timeZone: "UTC" });
const fmt = ([y, m]: YM) => month.format(Date.UTC(y, m - 1, 1)).replace(/\./g, "");
const iso = ([y, m]: YM) => `${y}-${String(m).padStart(2, "0")}`;
const jobs = jobMeta.map((m, i) => ({ ...m, ...t.experience.jobs[i] }));
---

<section class="section" id="experience" aria-labelledby="experience-title">
  <div class="container">
    <h2 class="section-title" id="experience-title">{t.sections.experience}</h2>
    <ol class="jobs">
      {jobs.map((job) => (
        <li>
          <div class="when meta">
            <p>
              <time datetime={iso(job.start)}>{fmt(job.start)}</time> {t.experience.to} <time datetime={iso(job.end)}>{fmt(job.end)}</time>
            </p>
            <p>{job.mode}</p>
          </div>
          <div class="what">
            <h3>{job.role}</h3>
            <p class="employer">{job.company}{job.client && ` · ${job.client}`}</p>
            <ul class="bullets">{job.bullets.map((b) => <li>{nb(b)}</li>)}</ul>
            <ul class="tech-line">{job.tech.map((tag) => <li>{tag}</li>)}</ul>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .jobs { list-style: none; margin: 0; padding: 0; }
  .jobs > li { display: grid; gap: 0.5rem 2rem; padding-block: 1.75rem; border-top: 1px solid var(--border); }
  .jobs > li:last-child { border-bottom: 1px solid var(--border); }
  @media (min-width: 768px) { .jobs > li { grid-template-columns: 11rem 1fr; } }
  .when p { margin: 0; }
  .what { display: grid; gap: 0.75rem; }
  h3 { font-size: var(--fs-lede); margin: 0; }
  .employer { margin: -0.5rem 0 0; color: var(--text-2); }
  .bullets { margin: 0; padding-left: 1.25rem; max-width: var(--measure); }
  .bullets li { list-style: disc; margin-block: 0.375rem; }
</style>
