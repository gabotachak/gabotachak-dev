---
import { translations, type Lang } from "../i18n/translations";
import { nb } from "../i18n/format";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = translations[lang];
---

<!-- PLACEHOLDER: renders the existing items without emoji. The approach agent tightens the copy. -->
<section class="section" id="approach" aria-labelledby="approach-title">
  <div class="container">
    <h2 class="section-title" id="approach-title">{t.sections.approach}</h2>
    <ul class="items">
      {t.approach.map((item) => (
        <li>
          <h3>{item.title}</h3>
          <p class="meta">{nb(item.desc)}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .items { list-style: none; margin: 0; padding: 0; display: grid; gap: 2rem 3rem; }
  @media (min-width: 640px) { .items { grid-template-columns: 1fr 1fr; } }
  h3 { margin-bottom: 0.5rem; }
</style>
