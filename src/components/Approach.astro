---
import { translations, type Lang } from "../i18n/translations";
import { nb } from "../i18n/format";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = translations[lang];
---

<section class="section" id="approach" aria-labelledby="approach-title">
  <div class="container">
    <h2 class="section-title" id="approach-title">{t.sections.approach}</h2>
    <ul class="items">
      {t.approach.map((item) => (
        <li>
          <h3>{item.title}</h3>
          <p>{nb(item.desc)}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .items { list-style: none; margin: 0; padding: 0; display: grid; gap: 0 3rem; }
  @media (min-width: 768px) { .items { grid-template-columns: 1fr 1fr; } }
  .items li { padding-block: 1.25rem; border-top: 1px solid var(--border); }
  h3 { font-size: var(--fs-body); margin: 0 0 0.375rem; }
  p { margin: 0; color: var(--text-2); max-width: var(--measure); }
</style>
