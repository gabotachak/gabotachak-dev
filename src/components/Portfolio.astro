      <div id="lfm-track"  style="font-size:11px;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:180px;">—</div>
      <div id="lfm-artist" style="font-size:10px;color:var(--tag-color);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:180px;">—</div>
    </div>

    <svg style="flex-shrink:0;opacity:0.25;" width="14" height="14" viewBox="0 0 24 24" fill="#d51007">
      <path d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zm5.87 16.716c-.504.239-2.046.941-3.967.941-3.29 0-5.042-2.222-5.042-4.93 0-2.768 1.685-4.96 5.042-4.96 1.664 0 3.098.619 3.9.995l-.665 1.886c-.686-.361-1.64-.79-3.096-.79-1.97 0-3.076 1.363-3.076 2.86 0 1.616 1.106 2.889 3.076 2.889 1.244 0 2.303-.497 3.08-.879l.748 1.988z"/>
