    <div style="flex:1; min-width:0;">
      <div style="display:flex; align-items:center; gap:6px; margin-bottom:2px;">
        <span id="lfm-status-dot" style="width:6px;height:6px;border-radius:50%;background:var(--muted);flex-shrink:0;"></span>
        <span id="lfm-status-text" style="font-size:9px;letter-spacing:0.15em;text-transform:uppercase;color:var(--tag-color);">{t.lfm.loading}</span>
