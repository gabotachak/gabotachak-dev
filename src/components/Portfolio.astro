  </div>

  <!-- Last.fm floating mini-player -->
  <a
    id="lastfm-widget"
    href={`https://www.last.fm/user/${LASTFM_USER}`}
    target="_blank"
    data-user={LASTFM_USER}
    data-key={LASTFM_KEY}
    style="
      position: fixed;
      bottom: 16px;
      right: 16px;
      z-index: 100;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 12px;
      background: var(--widget-bg);
      border: 1px solid var(--widget-border);
      border-radius: 12px;
      backdrop-filter: blur(12px);
      text-decoration: none;
