      <div id="lfm-art-placeholder" style="width:36px;height:36px;border-radius:6px;background:var(--art-placeholder-bg);display:flex;align-items:center;justify-content:center;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke-width="2">
