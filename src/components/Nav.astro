---
import { chrome } from "../i18n/chrome";
import { localeHref } from "../i18n/format";
import type { Lang } from "../i18n/translations";

interface Props {
  lang: Lang;
  /** Language-neutral path of the current page: "" for home, "uses" for /uses. */
  path?: string;
}

const { lang, path = "" } = Astro.props;
const n = chrome[lang].nav;
const home = localeHref(lang);
const other: Lang = lang === "en" ? "es" : "en";
const onUses = path === "uses";

const sections = [
  { id: "work", label: n.work },
  { id: "experience", label: n.experience },
  { id: "stack", label: n.stack },
];
---

<a class="skip-link" href="#main">
  {n.skip}
</a>

<header class="site-header no-print">
  <div class="container header-inner">
    <a class="logo" href={home}>
      gabotachak<span>.dev</span>
    </a>

    <nav class="nav" id="nav-panel" aria-label={n.label} data-open="false">
      <ul class="nav-links">
        {sections.map((s) => (
          <li>
            <a class="nav-link" href={`${home}#${s.id}`} data-section={s.id}>
              {s.label}
            </a>
          </li>
        ))}
        <li>
          <a class="nav-link" href={localeHref(lang, "uses")} aria-current={onUses ? "page" : undefined}>
            {n.uses}
          </a>
        </li>
        <li>
          <a class="nav-link ext" href="/cv.pdf" target="_blank" rel="noopener noreferrer">
            {n.cv}
          </a>
        </li>
        <li>
          <a class="btn btn-primary nav-cta" href={`${home}#contact`} data-section="contact">
            {n.contact}
          </a>
        </li>
      </ul>
    </nav>

    <div class="tools">
      <a class="lang-link" href={localeHref(other, path)} lang={n.langCode} hreflang={n.langCode} aria-label={n.langName}>
        {n.langText}
      </a>
      <button class="icon-btn theme-toggle" type="button" aria-label={n.toLight} data-to-light={n.toLight} data-to-dark={n.toDark}>
        <svg
          class="icon-sun"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4.5"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg
          class="icon-moon"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
      </button>
      <button
        class="icon-btn menu-toggle"
        type="button"
        aria-label={n.menuOpen}
        aria-expanded="false"
        aria-controls="nav-panel"
        data-open-label={n.menuOpen}
        data-close-label={n.menuClose}
      >
        <svg
          class="icon-open"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M3 6h18M3 12h18M3 18h18"></path>
        </svg>
        <svg
          class="icon-close"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M5 5l14 14M19 5L5 19"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--nav-bg);
    backdrop-filter: blur(12px) saturate(140%);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    border-bottom: 1px solid var(--border);
  }
  @media (prefers-reduced-transparency: reduce) {
    .site-header {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    min-height: var(--header-h);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    margin-right: auto;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
  }
  .logo span {
    color: var(--text-3);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.5rem;
    font-size: var(--fs-meta);
    color: var(--text-2);
    text-decoration: none;
  }
  .nav-link[aria-current] {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.4em;
  }
  @media (hover: hover) {
    .nav-link:hover {
      color: var(--text);
    }
  }

  .nav-cta {
    margin-left: 0.5rem;
    padding-inline: 1rem;
    font-size: var(--fs-meta);
  }
  .nav-cta[aria-current] {
    box-shadow:
      0 0 0 2px var(--bg),
      0 0 0 4px var(--accent);
  }

  .tools {
    display: flex;
    align-items: center;
    margin-left: 0.25rem;
  }

  .lang-link,
  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    color: var(--text-2);
    text-decoration: none;
  }
  .lang-link {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .icon-btn {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  @media (hover: hover) {
    .lang-link:hover,
    .icon-btn:hover {
      color: var(--text);
    }
  }

  /* The sun offers light, the moon offers dark. */
  .icon-moon,
  .icon-close {
    display: none;
  }
  :global(html.light) .icon-sun {
    display: none;
  }
  :global(html.light) .icon-moon {
    display: block;
  }

  /* Both buttons need JS. */
  :global(html.no-js) .theme-toggle,
  :global(html.no-js) .menu-toggle,
  .menu-toggle {
    display: none;
  }

  /* Below 768px the links collapse into a panel under the header. */
  @media (max-width: 767.98px) {
    .header-inner {
      flex-wrap: wrap;
    }

    :global(html:not(.no-js)) .menu-toggle {
      display: inline-flex;
    }
    .menu-toggle[aria-expanded="true"] .icon-open {
      display: none;
    }
    .menu-toggle[aria-expanded="true"] .icon-close {
      display: block;
    }

    .nav {
      order: 3;
      flex-basis: 100%;
    }
    .nav-links {
      flex-wrap: wrap;
    }

    :global(html:not(.no-js)) .nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      order: 0;
      padding: 0.25rem clamp(1rem, 4vw, 2rem) 1rem;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      /* visibility keeps the closed panel out of the tab order and the accessibility tree. */
      visibility: hidden;
      opacity: 0;
      transform: translateY(-0.5rem);
      transition:
        opacity 0.15s,
        transform 0.15s,
        visibility 0s 0.15s;
    }
    :global(html:not(.no-js)) .nav[data-open="true"] {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition-delay: 0s;
    }
    :global(html:not(.no-js)) .nav-links {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
    :global(html:not(.no-js)) .nav-link {
      width: 100%;
      border-bottom: 1px solid var(--border);
      padding-inline: 0;
    }
    :global(html:not(.no-js)) .nav-cta {
      margin: 0.75rem 0 0;
      width: 100%;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const header = document.querySelector<HTMLElement>(".site-header");
  const w = window as unknown as { setTheme?: (light: boolean, persist: boolean) => void };

  const read = (k: string) => {
    try {
      return localStorage.getItem(k);
    } catch {
      return null;
    }
  };

  // Theme toggle: the head script owns the class; this only flips it and keeps the label honest.
  const themeBtn = document.querySelector<HTMLButtonElement>(".theme-toggle");
  const syncTheme = () => {
    if (!themeBtn) return;
    const light = root.classList.contains("light");
    themeBtn.setAttribute("aria-label", (light ? themeBtn.dataset.toDark : themeBtn.dataset.toLight) ?? "");
  };
  syncTheme();
  themeBtn?.addEventListener("click", () => {
    w.setTheme?.(!root.classList.contains("light"), true);
    syncTheme();
  });
  try {
    matchMedia("(prefers-color-scheme: light)").addEventListener("change", (e) => {
      const saved = read("theme");
      if (saved === "light" || saved === "dark") return; // a saved choice wins over the OS
      w.setTheme?.(e.matches, false);
      syncTheme();
    });
  } catch {}

  // Mobile menu.
  const menuBtn = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const panel = document.getElementById("nav-panel");
  const isOpen = () => panel?.dataset.open === "true";
  const setMenu = (open: boolean) => {
    if (!panel || !menuBtn) return;
    panel.dataset.open = String(open);
    menuBtn.setAttribute("aria-expanded", String(open));
    menuBtn.setAttribute("aria-label", (open ? menuBtn.dataset.closeLabel : menuBtn.dataset.openLabel) ?? "");
  };
  menuBtn?.addEventListener("click", () => setMenu(!isOpen()));
  panel?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setMenu(false)));
  document.addEventListener("click", (e) => {
    if (isOpen() && header && !header.contains(e.target as Node)) setMenu(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && isOpen()) {
      setMenu(false);
      menuBtn?.focus();
    }
  });
  matchMedia("(min-width: 768px)").addEventListener("change", (e) => e.matches && setMenu(false));

  // Language switch keeps the page and, with JS, the current hash.
  const langLink = document.querySelector<HTMLAnchorElement>(".lang-link");
  if (langLink) {
    const base = langLink.getAttribute("href")!.split("#")[0];
    const keepHash = () => langLink.setAttribute("href", base + location.hash);
    ["pointerenter", "focus", "click"].forEach((ev) => langLink.addEventListener(ev, keepHash));
  }

  // Active section: whichever one crosses a band near the middle of the viewport.
  const links = document.querySelectorAll<HTMLElement>("[data-section]");
  const setActive = (id: string) =>
    links.forEach((l) => (l.dataset.section === id ? l.setAttribute("aria-current", "true") : l.removeAttribute("aria-current")));
  const sections = document.querySelectorAll<HTMLElement>("main section");
  if ("IntersectionObserver" in window && sections.length) {
    const io = new IntersectionObserver((entries) => entries.forEach((e) => e.isIntersecting && setActive((e.target as HTMLElement).id)), {
      rootMargin: "-45% 0px -50% 0px",
    });
    sections.forEach((s) => io.observe(s));
    // The closing section can be too short to reach the band.
    addEventListener(
      "scroll",
      () => {
        if (innerHeight + scrollY >= root.scrollHeight - 2) setActive("contact");
      },
      { passive: true },
    );
  }
</script>
