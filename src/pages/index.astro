---
import Layout from "../layouts/Layout.astro";

const LASTFM_USER = import.meta.env.PUBLIC_LASTFM_USER ?? "RobotDogger";
const LASTFM_KEY  = import.meta.env.PUBLIC_LASTFM_API_KEY ?? "";

const roles = ["Backend Engineer", "IAM Specialist", "Go Developer", "Python Dev"];

const experience = [
  {
    company: "Workstate",
    client: "Compass",
    role: "Mid Backend Engineer",
    period: "Apr 2026 — present",
    active: true,
    desc: "Building high-performance Go APIs for one of the US's leading real estate platforms. Distributed international team, production-scale systems.",
    tags: ["Go", "microservices", "REST API"],
  },
  {
    company: "NEORIS",
    client: "The Home Depot US",
    role: "Senior Backend Developer",
    period: "Dec 2025 — Mar 2026",
    active: false,
    desc: "Backend microservices in Go for the Home Depot retail ecosystem. Technical design, cloud integrations, and code reviews in English.",
    tags: ["Go", "microservices", "GCP"],
  },
  {
    company: "Personally AI",
    client: null,
    role: "Backend Developer Consultant",
    period: "Oct — Nov 2025",
    active: false,
    desc: "Python APIs for enterprise communications. WhatsApp Business integration, Selenium scraping, GPT-powered workflows.",
    tags: ["Python", "WhatsApp API", "GPT", "Selenium"],
  },
  {
    company: "Mercado Libre",
    client: null,
    role: "Cybersecurity Developer — IAM",
    period: "Jun 2021 — Sep 2025",
    active: false,
    desc: "4+ years in Identity & Access Management. Automated provisioning, deprovisioning, and access rotation for all MercadoLibre employees across AWS, GCP, and 100+ internal systems.",
    tags: ["Go", "Python", "OAuth2", "RBAC", "AWS", "GCP", "SOX"],
    highlight: true,
  },
];

const projects = [
  {
    name: "tax-time",
    emoji: "🧾",
    desc: "Colombian AI tax advisor. 100% local, no internet, no subscriptions. Runs entirely on Ollama.",
    url: "https://github.com/gabotachak/tax-time",
