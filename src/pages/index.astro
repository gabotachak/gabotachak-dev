---

<Layout title="gabotachak.dev" description="Gabriel Anzola Tachak — Backend Engineer. Go, Python, IAM. Bogotá.">
  <div class="bg-grid min-h-screen">
    <div class="hero-glow"></div>

    <!-- Nav -->
    <nav class="fixed top-0 left-0 right-0 z-50 flex justify-between items-center px-4 md:px-8 py-4 backdrop-blur-sm" style="background: rgba(8,8,8,0.85); border-bottom: 1px solid rgba(255,255,255,0.04);">
      <span class="text-[#00d9ff] text-xs tracking-widest font-bold">gabotachak<span style="color:#3a3a3a">.dev</span></span>
      <div class="flex gap-3 md:gap-6">
        <a href="#experience" class="nav-link hidden sm:inline">exp</a>
        <a href="#projects"   class="nav-link hidden sm:inline">projects</a>
        <a href="#stack"      class="nav-link hidden sm:inline">stack</a>
        <a href="mailto:hi@gabotachak.dev" class="nav-link" style="color:#00d9ff">contact</a>
      </div>
    </nav>

    <!-- Hero -->
    <section class="relative z-10 max-w-4xl mx-auto px-4 md:px-8 pt-36 pb-24">
      <div class="flex flex-col-reverse md:flex-row items-start md:items-center gap-8 md:gap-10">

        <!-- Avatar -->
        <div class="avatar-ring flex-shrink-0">
          <img
            src="https://avatars.githubusercontent.com/u/42346365?v=4"
            alt="Gabriel Anzola Tachak"
            width="120" height="120"
            style="border-radius:50%; display:block; position:relative; z-index:1;"
          />
        </div>

        <!-- Text -->
        <div class="flex-1">
          <div class="text-xs tracking-[0.25em] uppercase mb-3" style="color:#3a3a3a">
            <span style="color:#00d9ff66">▶</span> identity verified
          </div>

          <h1 id="hero-name" class="text-4xl md:text-5xl font-bold text-white mb-2 tracking-tight" style="letter-spacing:-0.5px;">
            Gabriel Anzola Tachak
          </h1>

          <div class="flex items-center gap-3 mb-5" style="height:28px;">
            <span style="color:#00d9ff; opacity:0.5; font-size:14px;">~/</span>
            <span id="role-text" class="cursor text-lg font-medium" style="color:#00d9ff; min-width:220px;"></span>
          </div>

          <p class="text-sm leading-relaxed mb-6 max-w-lg" style="color:#888;">
            Backend engineer with 4+ years at MercadoLibre in Identity & Access Management.
            Go and Python. Now building at Workstate for Compass, US real estate at scale.
            UNAL Systems Engineering.
          </p>

          <div class="flex gap-5 text-xs">
            <a href="https://github.com/gabotachak" target="_blank" class="nav-link flex items-center gap-1.5">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
              github
            </a>
            <a href="https://linkedin.com/in/gabotachak" target="_blank" class="nav-link flex items-center gap-1.5">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              linkedin
            </a>
            <a href="mailto:hi@gabotachak.dev" class="nav-link flex items-center gap-1.5">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              hi@gabotachak.dev
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Experience -->
    <section id="experience" class="relative z-10 max-w-4xl mx-auto px-4 md:px-8 pb-24 reveal">
      <div class="section-label">experience</div>

      <div class="relative pl-8">
        <div class="timeline-line"></div>

        <div class="space-y-10">
          {experience.map((job, i) => (
            <div class="relative flex gap-6 items-start">
              <div class={`timeline-dot ${job.active ? '' : 'inactive'}`} style="flex-shrink:0; margin-top:2px;"></div>
              <div class="flex-1 min-w-0">
                <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-2">
                  <div>
                    <span class="text-white font-semibold text-sm">{job.role}</span>
                    <span style="color:#444"> @ </span>
                    <span class="text-sm" style="color:#00d9ff">{job.company}</span>
                    {job.client && <span class="text-xs" style="color:#555"> · {job.client}</span>}
                    {job.active && <span class="ml-2 text-[10px] px-1.5 py-0.5 rounded" style="background:#00d9ff12; color:#00d9ff; border:1px solid #00d9ff22;">active</span>}
                  </div>
                  <span class="text-xs shrink-0" style="color:#444; font-family:inherit;">{job.period}</span>
                </div>
                <p class="text-xs leading-relaxed mb-3" style="color:#666;">{job.desc}</p>
                <div class="flex flex-wrap gap-1.5">
                  {job.tags.map(tag => (
                    <span class="text-[10px] px-2 py-0.5 rounded" style="background:#ffffff06; color:#555; border:1px solid #1f1f1f;">{tag}</span>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Projects -->
    <section id="projects" class="relative z-10 max-w-4xl mx-auto px-4 md:px-8 pb-24 reveal">
      <div class="section-label">projects</div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {projects.map((p) => (
          <a href={p.url} target="_blank" class="project-card group" style={`--card-accent: ${p.accent};`}>
            <div class="flex items-start justify-between mb-3">
              <span class="text-lg">{p.emoji}</span>
              <svg class="opacity-0 group-hover:opacity-100 transition-opacity" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#00d9ff" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </div>
            <h3 class="text-sm font-semibold text-white mb-2 group-hover:text-[var(--card-accent)] transition-colors font-mono">{p.name}</h3>
            <p class="text-xs leading-relaxed mb-3" style="color:#555;">{p.desc}</p>
            <div class="flex flex-wrap gap-1">
              {p.tags.map(tag => (
                <span class="text-[10px] px-1.5 py-0.5 rounded" style="background:#0a0a0a; color:#3a3a3a; border:1px solid #161616;">{tag}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Stack -->
    <section id="stack" class="relative z-10 max-w-4xl mx-auto px-4 md:px-8 pb-32 reveal">
      <div class="section-label">stack</div>

      <div class="flex flex-wrap gap-2">
        {stack.map(s => (
          <span class={`chip ${s.cls}`}>{s.label}</span>
        ))}
      </div>
    </section>

    <!-- Footer -->
    <footer class="relative z-10 max-w-4xl mx-auto px-4 md:px-8 pb-8">
      <div class="flex justify-between items-center text-[10px] pt-4" style="border-top:1px solid #111; color:#2a2a2a;">
        <span class="prompt">Bogotá, Colombia · GMT-5</span>
        <span>built with Astro · <a href="https://github.com/gabotachak/gabotachak-dev" target="_blank" style="color:#333; text-decoration:none; transition:color 0.2s;" onmouseover="this.style.color='#00d9ff'" onmouseout="this.style.color='#333'">source</a></span>
      </div>
    </footer>
  </div>

  <!-- Last.fm floating mini-player -->
  <a
    id="lastfm-widget"
    href={`https://www.last.fm/user/${LASTFM_USER}`}
    target="_blank"
    data-user={LASTFM_USER}
    data-key={LASTFM_KEY}
    style="
      position: fixed;
      bottom: 16px;
      right: 16px;
      z-index: 100;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 12px;
      background: rgba(10,10,10,0.92);
      border: 1px solid #1e1e1e;
      border-radius: 12px;
      backdrop-filter: blur(12px);
      text-decoration: none;
      color: inherit;
      transition: border-color 0.2s, box-shadow 0.2s;
      max-width: min(280px, calc(100vw - 32px));
    "
    onmouseover="this.style.borderColor='rgba(0,217,255,0.3)'; this.style.boxShadow='0 0 20px rgba(0,217,255,0.06)'"
    onmouseout="this.style.borderColor='#1e1e1e'; this.style.boxShadow='none'"
  >
    <!-- Album art -->
    <div style="position:relative; flex-shrink:0;">
      <img
        id="lfm-art"
        src="" alt=""
        style="width:36px;height:36px;border-radius:6px;object-fit:cover;display:none;"
      />
      <div id="lfm-art-placeholder" style="width:36px;height:36px;border-radius:6px;background:#1a1a1a;display:flex;align-items:center;justify-content:center;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#333" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/></svg>
      </div>
    </div>

    <!-- Track info -->
    <div style="flex:1; min-width:0;">
      <div style="display:flex; align-items:center; gap:6px; margin-bottom:2px;">
        <span id="lfm-status-dot" style="width:6px;height:6px;border-radius:50%;background:#333;flex-shrink:0;"></span>
        <span id="lfm-status-text" style="font-size:9px;letter-spacing:0.15em;text-transform:uppercase;color:#444;">loading…</span>
      </div>
      <div id="lfm-track"  style="font-size:11px;font-weight:600;color:#e4e4e7;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:180px;">—</div>
      <div id="lfm-artist" style="font-size:10px;color:#555;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:180px;">—</div>
    </div>

    <!-- Last.fm logo -->
    <svg style="flex-shrink:0;opacity:0.25;" width="14" height="14" viewBox="0 0 24 24" fill="#d51007">
      <path d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zm5.87 16.716c-.504.239-2.046.941-3.967.941-3.29 0-5.042-2.222-5.042-4.93 0-2.768 1.685-4.96 5.042-4.96 1.664 0 3.098.619 3.9.995l-.665 1.886c-.686-.361-1.64-.79-3.096-.79-1.97 0-3.076 1.363-3.076 2.86 0 1.616 1.106 2.889 3.076 2.889 1.244 0 2.303-.497 3.08-.879l.748 1.988z"/>
    </svg>
  </a>
</Layout>

<script>
  // ── Typing animation ──
  const roles = ["Backend Engineer", "IAM Specialist", "Go Developer", "Python Dev", "Bogotá 🇨🇴"];
  const el = document.getElementById('role-text');
  let roleIdx = 0;
  let charIdx = 0;
  let deleting = false;
  let pauseFrames = 0;

  function type() {
    if (!el) return;
    const current = roles[roleIdx];

    if (pauseFrames > 0) { pauseFrames--; setTimeout(type, 50); return; }

    if (!deleting) {
      el.textContent = current.slice(0, charIdx + 1);
      charIdx++;
      if (charIdx === current.length) { deleting = true; pauseFrames = 40; }
      setTimeout(type, 70);
    } else {
      el.textContent = current.slice(0, charIdx - 1);
      charIdx--;
      if (charIdx === 0) { deleting = false; roleIdx = (roleIdx + 1) % roles.length; pauseFrames = 5; }
      setTimeout(type, 35);
    }
  }
  setTimeout(type, 800);

  // ── Scramble hero name ──
  const nameEl = document.getElementById('hero-name');
  if (nameEl) {
    const finalText = nameEl.textContent ?? '';
    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789@#$%';
    let frame = 0;
    const totalFrames = 18;

    const scramble = () => {
      if (frame >= totalFrames) { nameEl.textContent = finalText; return; }
      const progress = frame / totalFrames;
      nameEl.textContent = finalText.split('').map((c, i) => {
        if (c === ' ') return ' ';
        if (i / finalText.length < progress) return c;
        return chars[Math.floor(Math.random() * chars.length)];
      }).join('');
      frame++;
      requestAnimationFrame(scramble);
    };
    setTimeout(() => requestAnimationFrame(scramble), 100);
  }

  // ── Last.fm Now Playing ──
  async function fetchNowPlaying() {
    const widget = document.getElementById('lastfm-widget');
    if (!widget) return;
    const user = widget.dataset.user;
    const key  = widget.dataset.key;
    if (!key || key === 'placeholder') return;

    try {
      const res  = await fetch(`https://ws.audioscrobbler.com/2.0/?method=user.getrecenttracks&user=${user}&api_key=${key}&format=json&limit=1`);
      const data = await res.json();
      const track = data?.recenttracks?.track?.[0];
      if (!track) return;

      const nowPlaying = track['@attr']?.nowplaying === 'true';
      const name   = track.name ?? '—';
      const artist = track.artist?.['#text'] ?? '—';
      const art    = track.image?.find((i: any) => i.size === 'medium')?.['#text'];

      const dot    = document.getElementById('lfm-status-dot');
      const status = document.getElementById('lfm-status-text');
      const trackEl  = document.getElementById('lfm-track');
      const artistEl = document.getElementById('lfm-artist');
      const artEl    = document.getElementById('lfm-art') as HTMLImageElement;
      const placeholder = document.getElementById('lfm-art-placeholder');

      if (trackEl)  trackEl.textContent  = name;
      if (artistEl) artistEl.textContent = artist;

      if (art && artEl) {
        artEl.src = art;
        artEl.style.display = 'block';
        if (placeholder) placeholder.style.display = 'none';
      }

      if (nowPlaying) {
        if (dot)    { dot.style.background = '#1db954'; dot.style.animation = 'pulse-dot 1.5s ease-in-out infinite'; }
        if (status) { status.textContent = 'now playing'; (status as HTMLElement).style.color = '#1db954'; }
      } else {
        const ts = track.date?.uts ? parseInt(track.date.uts) * 1000 : null;
        const ago = ts ? timeAgo(ts) : 'recently';
        if (dot)    { dot.style.background = '#444'; }
        if (status) { status.textContent = `last played ${ago}`; (status as HTMLElement).style.color = '#555'; }
      }
    } catch (e) { /* silent fail */ }
  }

  function timeAgo(ms: number): string {
    const diff = Date.now() - ms;
    const m = Math.floor(diff / 60000);
    const h = Math.floor(m / 60);
    const d = Math.floor(h / 24);
    if (d > 0)  return `${d}d ago`;
    if (h > 0)  return `${h}h ago`;
    if (m > 0)  return `${m}m ago`;
    return 'just now';
  }

  fetchNowPlaying();
  setInterval(fetchNowPlaying, 30000);

  // ── Scroll reveal ──
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('visible');
        observer.unobserve(e.target);
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
</script>
