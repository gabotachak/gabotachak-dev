    accent: "#00ff88",
  },
  {
    name: "pokemon-agent",
    emoji: "🤖",
    desc: "Multi-LLM AI agent framework using Claude + Gemini. No further context needed.",
    url: "https://github.com/gabotachak/pokemon-agent",
    tags: ["Python", "Claude", "Gemini"],
    accent: "#00d9ff",
  },
  {
    name: "logi-hyprland",
    emoji: "🖱️",
    desc: "Pure evdev gesture daemon for Logitech M720 on Hyprland. Zero Logitech Options dependency.",
    url: "https://github.com/gabotachak/logi-hyprland",
    tags: ["Python", "evdev", "Linux"],
    accent: "#a78bfa",
  },
  {
    name: "picas-fijas",
    emoji: "🧠",
    desc: "Mastermind solver using Knuth's minimax algorithm. Guaranteed ≤5 guesses.",
    url: "https://github.com/gabotachak/picas-fijas",
    tags: ["Python", "Minimax", "algorithms"],
    accent: "#fbbf24",
  },
  {
    name: "crypto-workshops",
    emoji: "🔐",
    desc: "Classical cipher implementations: Caesar, Hill, OTP, Playfair, Vigenère, Turning Grille.",
    url: "https://github.com/gabotachak/crypto-workshops",
    tags: ["Python", "cryptography"],
