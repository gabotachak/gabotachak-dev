const stack = [
  { label: "Go",         cls: "go"    },
  { label: "Python",     cls: "python"},
  { label: "TypeScript", cls: "ts"    },
  { label: "SQL",        cls: "db"    },
  { label: "Bash",       cls: ""      },
  { label: "OAuth2",     cls: "iam"   },
  { label: "JWT",        cls: "iam"   },
  { label: "RBAC",       cls: "iam"   },
  { label: "SOX / PCI",  cls: "iam"   },
  { label: "GCP",        cls: "infra" },
  { label: "AWS",        cls: "infra" },
  { label: "Docker",     cls: "infra" },
  { label: "Terraform",  cls: "infra" },
  { label: "Vault",      cls: "infra" },
  { label: "GitHub Actions", cls: "infra" },
  { label: "PostgreSQL", cls: "db"    },
  { label: "MySQL",      cls: "db"    },
  { label: "MongoDB",    cls: "db"    },
